((nil . ((project-name . "@PROJECT_NAME@")
  	 (org-agenda-files . ("@PROJECT_MANAGEMENT_DIRECTORY@/@PROJECT_NAME@.org" @SUBPROJECT_AGENDA_FILES@))
  	 (org-agenda-custom-commands . (("\\" "Hard Dates" tags "HAS_HARD_START_DATE=\"\"|HAS_HARD_START_DATE=\"\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task/Occurance) %HAS_HARD_START_DATE(Hard start?) %SCHEDULED(Start date) %HAS_HARD_DUE_DATE(Hard due?) %DEADLINE(Due date) %15CATEGORY(Project)") (org-agenda-overriding-header "Are there hard dates we need to be aware of?") (org-agenda-skip-function 'pmt-skip-references) (org-agenda-view-columns-initially t))) ("w" "Initial Scheduling" tags "HAS_HARD_START_DATE=\"yes\"|HAS_HARD_DUE_DATE=\"yes\"|FREQUENCY=\"repetitive\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task/Occurance) %HAS_HARD_START_DATE(Hard start?) %SCHEDULED(Start date) %HAS_HARD_DUE_DATE(Hard due?) %DEADLINE(Due date) %15CATEGORY(Project)") (org-agenda-overriding-header "What do we know is on the calendar?") (org-agenda-skip-function 'pmt-skip-references) (org-agenda-sorting-strategy '((tags deadline-up))) (org-agenda-view-columns-initially t))) ("[" "All Dependencies" tags "*" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %HARD_INTERNAL_DEPENDENCY(Hard Int) %SOFT_INTERNAL_DEPENDENCY(Soft Int) %HARD_EXTERNAL_DEPENDENCY(Hard Ext) %SOFT_EXTERNAL_DEPENDENCY(Soft Ext) %15CATEGORY(Project)") (org-agenda-overriding-header "Are there dependencies for these tasks?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags alpha-up))) (org-agenda-view-columns-initially t))) ("g" "Initial Dependencies" tags "HARD_INTERNAL_DEPENDENCY=\"\"&SOFT_INTERNAL_DEPENDENCY=\"\"HARD_EXTERNAL_DEPENDENCY=\"\"SOFT_EXTERNAL_DEPENDENCY=\"\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %HARD_INTERNAL_DEPENDENCY(Hard Int) %SOFT_INTERNAL_DEPENDENCY(Soft Int) %HARD_EXTERNAL_DEPENDENCY(Hard Ext) %SOFT_EXTERNAL_DEPENDENCY(Soft Ext) %15CATEGORY(Project)") (org-agenda-overriding-header "Are there dependencies for these tasks?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags alpha-up))) (org-agenda-view-columns-initially t))) ("/" "Strategic Evaluation" tags "FREQUENCY=\"once\"" ((org-agenda-cmp-user-defined 'pmt-org-cmp-strategic-value) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %STRATEGIC_VALUE(Strat Val) %15CATEGORY(Project)") (org-agenda-overriding-header "How beneficial would this be if all tasks were finished?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-down))) (org-agenda-view-columns-initially t))) ("l" "Tactial Evaluation" ((tags "FREQUENCY=\"once\"" ((org-agenda-cmp-user-defined 'pmt-org-cmp-tactical-value) (org-agenda-overriding-header "How beneficial would this task be if it were finished now?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-down))))) (tags "FREQUENCY=\"repetitive\"" ((org-agenda-cmp-user-defined 'pmt-org-cmp-tactical-value) (org-agenda-overriding-header "How beneficial would this routine be if it were finished now?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-down)))))) ((org-agenda-view-columns-initially t) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %TACTICAL_VALUE(Tac Val) %DEADLINE(Due date) %HAS_HARD_DUE_DATE(Hard due?) %15CATEGORY(Project)"))) ("a" "Effort Estimation" tags "TACTICAL_VALUE<>\"less\"" ((org-agenda-cmp-user-defined 'pmt-org-cmp-estimated-effort) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Tac Valuable, Doable Task) %ESTIMATED_EFFORT(Effort) %15CATEGORY(Project)") (org-agenda-overriding-header "How much of our effort would this take to finish?") (org-agenda-skip-function 'pmt-skip-all-dependent-tasks) (org-agenda-sorting-strategy '((tags user-defined-up))) (org-agenda-view-columns-initially t))) ("t" "Activity" tags "DEADLINE<=\"<+2w>\"|TACTICAL_VALUE=\"more\"&DEADLINE=\"\"ESTIMATED_EFFORT=\"less\"&DEADLINE=\"\"" ((org-agenda-cmp-user-defined 'pmt-org-cmp-tactical-value) (org-overriding-columns-format "%7TODO(When) %30ITEM(Task) %TACTICAL_VALUE(Tac Val) %ESTIMATED_EFFORT(Effort) %17DEADLINE(Due date) %5HAS_HARD_DUE_DATE(Hard?) %15CATEGORY(Project)") (org-agenda-overriding-header "When are we doing these tasks?") (org-agenda-skip-function 'pmt-skip-all-dependent-tasks) (org-agenda-sorting-strategy '((tags user-defined-up))) (org-agenda-view-columns-initially t))) ("q" "Basics" tags "*" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %FREQUENCY(Freq) %HAS_HARD_START_DATE(Hard start?) %HAS_HARD_DUE_DATE(Hard due?) %15CATEGORY(Project)") (org-agenda-overriding-header "What are the basics?") (org-agenda-skip-function 'pmt-skip-top-level-headlines) (org-agenda-view-columns-initially t))) ("s" "Focus" tags "TODO=\"now\"" ((org-agenda-cmp-user-defined 'pmt-org-cmp-estimated-effort) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %15CATEGORY(Project)") (org-agenda-overriding-header "What are we focusing on right now?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-up))) (org-agenda-view-columns-initially t))) ("e" "Calendar" agenda "SCHEDULED<>\"\"|DEADLINE<>\"\"" ((org-agenda-overriding-header "What's on the calendar?") (org-agenda-prefix-format '((agenda . ""))) (org-agenda-skip-function 'pmt-skip-top-level-headlines) (org-agenda-sorting-strategy '((tags deadline-up))) (org-agenda-span 'week) (org-agenda-use-time-grid nil)) ("@PROJECT_DIRECTORY@project/calendar.html" "@PROJECT_DIRECTORY@project/calendar.ps" "@PROJECT_DIRECTORY@project/calendar.ics")) ("n" "Dependent Tasks" tags "HARD_INTERNAL_DEPENDENCY=\"yes\"|SOFT_INTERNAL_DEPENDENCY=\"yes\"|HARD_EXTERNAL_DEPENDENCY=\"yes\"|SOFT_EXTERNAL_DEPENDENCY=\"yes\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %HARD_INTERNAL_DEPENDENCY(Hard Int) %SOFT_INTERNAL_DEPENDENCY(Soft Int) %HARD_EXTERNAL_DEPENDENCY(Hard Ext) %SOFT_EXTERNAL_DEPENDENCY(Soft Ext) %15CATEGORY(Project)") (org-agenda-overriding-header "What tasks have outstanding dependencies?") (org-agenda-skip-function 'pmt-skip-non-tasks) (org-agenda-sorting-strategy '((tags alpha-up))) (org-agenda-view-columns-initially t))) ("c" "Done Items" tags "TODO=\"past\"" ((org-agenda-overriding-header "What have we done?") (org-agenda-prefix-format '((tags . ""))) (org-agenda-skip-function 'pmt-skip-top-level-headlines) (org-agenda-skip-function-global nil) (org-agenda-sorting-strategy '((tags alpha-up))))) ("," "All Items" tags "*" ((org-agenda-overriding-header "What are all the items in @PROJECT_NAME@?") (org-agenda-prefix-format '((tags . ""))) (org-agenda-skip-function 'pmt-skip-top-level-headlines) (org-agenda-sorting-strategy '((tags alpha-up)))) ("@PROJECT_DIRECTORY@project/test.html" "@PROJECT_DIRECTORY@project/test.ps" "@PROJECT_DIRECTORY@project/test.ics"))))
  	 (org-archive-location . "%s_archive::")
  	 (org-archive-mark-done . t)
  	 (org-directory . "@PROJECT_MANAGEMENT_DIRECTORY@/")
  	 (org-capture-templates . (("s" "Task" entry
  				    (file+headline "@PROJECT_NAME@.org" "Tasks")
  				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: once\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: no\n:HARD_INTERNAL_DEPENDENCY: no \n:SOFT_INTERNAL_DEPENDENCY: no \n:HARD_EXTERNAL_DEPENDENCY: no \n:SOFT_EXTERNAL_DEPENDENCY: no \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
  				   ("." "Time-bound task" entry
  				    (file+headline "@PROJECT_NAME@.org" "Tasks")
  				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: once\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: yes\n:HARD_INTERNAL_DEPENDENCY: no \n:SOFT_INTERNAL_DEPENDENCY: no \n:HARD_EXTERNAL_DEPENDENCY: no \n:SOFT_EXTERNAL_DEPENDENCY: no \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
  				   ("e" "Routine" entry
  				    (file+headline "@PROJECT_NAME@.org" "Tasks")
  				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: repetitive\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: no\n:HARD_INTERNAL_DEPENDENCY: no \n:SOFT_INTERNAL_DEPENDENCY: no \n:HARD_EXTERNAL_DEPENDENCY: no \n:SOFT_EXTERNAL_DEPENDENCY: no \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
  				   (")" "Time-bound routine" entry
  				    (file+headline "@PROJECT_NAME@.org" "Tasks")
  				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: repetitive\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: yes\n:HARD_INTERNAL_DEPENDENCY: no \n:SOFT_INTERNAL_DEPENDENCY: no \n:HARD_EXTERNAL_DEPENDENCY: no \n:SOFT_EXTERNAL_DEPENDENCY: no \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
  				   ("n" "Practice" entry
