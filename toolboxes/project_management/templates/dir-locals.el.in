((nil . ((project-name . "@PROJECT_NAME@")
	 (org-agenda-files . ("@PROJECT_DIRECTORY@/project_management/@PROJECT_NAME@.org" @SUBPROJECT_DIRECTORIES@))
	 (org-agenda-custom-commands . (("\\" "Hard Dates" tags "HAS_HARD_START_DATE=\"\"|HAS_HARD_START_DATE=\"\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task/Occurance) %HAS_HARD_START_DATE(Hard start?) %SCHEDULED(Start date) %HAS_HARD_DUE_DATE(Hard due?) %DEADLINE(Due date) %15CATEGORY(Category)") (org-agenda-overriding-header "Are there hard dates we need to be aware of?") (org-agenda-skip-function 'my-skip-references) (org-agenda-view-columns-initially t))) ("w" "Initial Scheduling" tags "HAS_HARD_START_DATE=\"yes\"|HAS_HARD_DUE_DATE=\"yes\"|FREQUENCY=\"repetitive\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task/Occurance) %HAS_HARD_START_DATE(Hard start?) %SCHEDULED(Start date) %HAS_HARD_DUE_DATE(Hard due?) %DEADLINE(Due date) %15CATEGORY(Category)") (org-agenda-overriding-header "What do we know is on the calendar?") (org-agenda-skip-function 'my-skip-references) (org-agenda-sorting-strategy '((tags deadline-up))) (org-agenda-view-columns-initially t))) ("[" "All Dependencies" tags "*" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %HARD_INTERNAL_DEPENDENCY(Hard Int) %SOFT_INTERNAL_DEPENDENCY(Soft Int) %HARD_EXTERNAL_DEPENDENCY(Hard Ext) %SOFT_EXTERNAL_DEPENDENCY(Soft Ext) %15CATEGORY(Category)") (org-agenda-overriding-header "Are there dependencies for these tasks?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags alpha-up))) (org-agenda-view-columns-initially t))) ("g" "Initial Dependencies" tags "HARD_INTERNAL_DEPENDENCY=\"\"&SOFT_INTERNAL_DEPENDENCY=\"\"HARD_EXTERNAL_DEPENDENCY=\"\"SOFT_EXTERNAL_DEPENDENCY=\"\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %HARD_INTERNAL_DEPENDENCY(Hard Int) %SOFT_INTERNAL_DEPENDENCY(Soft Int) %HARD_EXTERNAL_DEPENDENCY(Hard Ext) %SOFT_EXTERNAL_DEPENDENCY(Soft Ext) %15CATEGORY(Category)") (org-agenda-overriding-header "Are there dependencies for these tasks?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags alpha-up))) (org-agenda-view-columns-initially t))) ("/" "Strategic Evaluation" tags "FREQUENCY=\"once\"" ((org-agenda-cmp-user-defined 'my-org-cmp-strategic-value) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %STRATEGIC_VALUE(Strat Val) %15CATEGORY(Category)") (org-agenda-overriding-header "How beneficial would this be if all tasks were finished?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-down))) (org-agenda-view-columns-initially t))) ("l" "Tactial Evaluation" ((tags "FREQUENCY=\"once\"" ((org-agenda-cmp-user-defined 'my-org-cmp-tactical-value) (org-agenda-overriding-header "How beneficial would this task be if it were finished now?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-down))))) (tags "FREQUENCY=\"repetitive\"" ((org-agenda-cmp-user-defined 'my-org-cmp-tactical-value) (org-agenda-overriding-header "How beneficial would this routine be if it were finished now?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-down)))))) ((org-agenda-view-columns-initially t) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %TACTICAL_VALUE(Tac Val) %DEADLINE(Due date) %HAS_HARD_DUE_DATE(Hard due?) %15CATEGORY(Category)"))) ("a" "Effort Estimation" tags "TACTICAL_VALUE<>\"less\"" ((org-agenda-cmp-user-defined 'my-org-cmp-estimated-effort) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Tac Valuable, Doable Task) %ESTIMATED_EFFORT(Effort) %15CATEGORY(Category)") (org-agenda-overriding-header "How much of our effort would this take to finish?") (org-agenda-skip-function 'my-skip-all-dependent-tasks) (org-agenda-sorting-strategy '((tags user-defined-up))) (org-agenda-view-columns-initially t))) ("t" "Activity" tags "TACTICAL_VALUE<>\"less\"&DEADLINE=\"\"|DEADLINE<=\"<+2w>\"" ((org-agenda-cmp-user-defined 'my-org-cmp-estimated-effort) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %TACTICAL_VALUE(Tac Val) %ESTIMATED_EFFORT(Effort) %DEADLINE(Due date) %HAS_HARD_DUE_DATE(Hard due?) %15CATEGORY(Category)") (org-agenda-overriding-header "When are we doing these things?") (org-agenda-skip-function 'my-skip-all-dependent-tasks) (org-agenda-sorting-strategy '((tags todo-state-down))) (org-agenda-view-columns-initially t))) ("q" "Basics" tags "*" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %FREQUENCY(Freq) %HAS_HARD_START_DATE(Hard start?) %HAS_HARD_DUE_DATE(Hard due?) %15CATEGORY(Category)") (org-agenda-overriding-header "What are the basics?") (org-agenda-skip-function 'my-skip-top-level-headlines) (org-agenda-view-columns-initially t))) ("s" "Focus" tags "TODO=\"now\"" ((org-agenda-cmp-user-defined 'my-org-cmp-estimated-effort) (org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %15CATEGORY(Category)") (org-agenda-overriding-header "What are we focusing on right now?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags user-defined-up))) (org-agenda-view-columns-initially t))) ("e" "Calendar" agenda "SCHEDULED<>\"\"|DEADLINE<>\"\"" ((org-agenda-overriding-header "What's on the calendar?") (org-agenda-prefix-format '((agenda . ""))) (org-agenda-skip-function 'my-skip-top-level-headlines) (org-agenda-sorting-strategy '((tags deadline-up))) (org-agenda-span 'week) (org-agenda-use-time-grid nil)) ("@PROJECT_DIRECTORY@project/calendar.html" "@PROJECT_DIRECTORY@project/calendar.ps" "@PROJECT_DIRECTORY@project/calendar.ics")) ("n" "Dependent Tasks" tags "HARD_INTERNAL_DEPENDENCY=\"yes\"|SOFT_INTERNAL_DEPENDENCY=\"yes\"|HARD_EXTERNAL_DEPENDENCY=\"yes\"|SOFT_EXTERNAL_DEPENDENCY=\"yes\"" ((org-overriding-columns-format "%7TODO(Status) %30ITEM(Task) %HARD_INTERNAL_DEPENDENCY(Hard Int) %SOFT_INTERNAL_DEPENDENCY(Soft Int) %HARD_EXTERNAL_DEPENDENCY(Hard Ext) %SOFT_EXTERNAL_DEPENDENCY(Soft Ext) %15CATEGORY(Category)") (org-agenda-overriding-header "What tasks have outstanding dependencies?") (org-agenda-skip-function 'my-skip-non-tasks) (org-agenda-sorting-strategy '((tags alpha-up))) (org-agenda-view-columns-initially t))) ("c" "Done Items" tags "TODO=\"past\"" ((org-agenda-overriding-header "What have we done?") (org-agenda-prefix-format '((tags . ""))) (org-agenda-skip-function 'my-skip-top-level-headlines) (org-agenda-skip-function-global nil) (org-agenda-sorting-strategy '((tags alpha-up))))) ("," "All Items" tags "*" ((org-agenda-overriding-header "What are all the items in @PROJECT_NAME@?") (org-agenda-prefix-format '((tags . ""))) (org-agenda-skip-function 'my-skip-top-level-headlines) (org-agenda-sorting-strategy '((tags alpha-up)))) ("@PROJECT_DIRECTORY@project/test.html" "@PROJECT_DIRECTORY@project/test.ps" "@PROJECT_DIRECTORY@project/test.ics"))))
	 (org-archive-location . "%s_archive::")
	 (org-archive-mark-done . t)
	 (org-directory . "@PROJECT_DIRECTORY@/project_management/")
	 (org-capture-templates . (("s" "Task" entry
				    (file+headline "@PROJECT_NAME@.org" "Tasks")
				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: once\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: no\n:HARD_INTERNAL_DEPENDENCY: \n:SOFT_INTERNAL_DEPENDENCY: \n:HARD_EXTERNAL_DEPENDENCY: \n:SOFT_EXTERNAL_DEPENDENCY: \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
				   ("." "Task with due date" entry
				    (file+headline "@PROJECT_NAME@.org" "Tasks")
				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: once\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: yes\n:HARD_INTERNAL_DEPENDENCY: \n:SOFT_INTERNAL_DEPENDENCY: \n:HARD_EXTERNAL_DEPENDENCY: \n:SOFT_EXTERNAL_DEPENDENCY: \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
				   ("e" "Routine" entry
				    (file+headline "@PROJECT_NAME@.org" "Tasks")
				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: repetitive\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: no\n:HARD_INTERNAL_DEPENDENCY: \n:SOFT_INTERNAL_DEPENDENCY: \n:HARD_EXTERNAL_DEPENDENCY: \n:SOFT_EXTERNAL_DEPENDENCY: \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
				   (")" "Routine with due date" entry
				    (file+headline "@PROJECT_NAME@.org" "Tasks")
				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: repetitive\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: yes\n:HARD_INTERNAL_DEPENDENCY: \n:SOFT_INTERNAL_DEPENDENCY: \n:HARD_EXTERNAL_DEPENDENCY: \n:SOFT_EXTERNAL_DEPENDENCY: \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
				   ("n" "Occurance" entry
				    (file+headline "@PROJECT_NAME@.org" "Occurances")
				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:END:\n%?")
				   ("y" "Reference" entry
				    (file+headline "@PROJECT_NAME@.org" "References")
				    "* %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:END:\n%?")
				   ("o" "User story" entry
				    (file+headline "@PROJECT_NAME@.org" "User stories")
				    "* future %^{Title}\n:PROPERTIES:\n:CATEGORY: @PROJECT_NAME@\n:FREQUENCY: once\n:HAS_HARD_START_DATE: no\n:HAS_HARD_DUE_DATE: no\n:HARD_INTERNAL_DEPENDENCY: \n:SOFT_INTERNAL_DEPENDENCY: \n:HARD_EXTERNAL_DEPENDENCY: \n:SOFT_EXTERNAL_DEPENDENCY: \n:STRATEGIC_VALUE: average\n:TACTICAL_VALUE: average\n:ESTIMATED_EFFORT: average\n:ESTIMATED_$_COST: trivial\n:ACTUAL_EFFORT: \n:ACTUAL_$_COST: \n:END:\n%?")
				   ("i" "Idea" item
				    (file+headline "@PROJECT_NAME@.org" "Ideas")
				    "%^{Title}\n" :immediate-finish t)))
	 (org-deadline-warning-days . 0)
	 ;; (org-priority-highest . 2)
	 ;; (org-priority-default . 2)
	 ;; (org-priority-lowest . 2)
	 (org-global-properties . (("FREQUENCY_ALL" . "once repetitive continuous")
				   ("HAS_HARD_START_DATE_ALL" . "no yes")
      				   ("HAS_HARD_DUE_DATE_ALL" . "no yes")
				   ("HAS_SOFT_START_DATE_ALL" . "no yes")
      				   ("HAS_SOFT_DUE_DATE_ALL" . "no yes")
				   ;; SCHEDULED functions as start date
      				   ;; DEADLINE functions as due date
				   ("HARD_INTERNAL_DEPENDENCY_ALL" . "no yes")
				   ("SOFT_INTERNAL_DEPENDENCY_ALL" . "no yes")
				   ("HARD_EXTERNAL_DEPENDENCY_ALL" . "no yes")
				   ("SOFT_EXTERNAL_DEPENDENCY_ALL" . "no yes")
				   ("STRATEGIC_VALUE_ALL" . "less average more")
				   ("TACTICAL_VALUE_ALL" . "less average more")
				   ("ESTIMATED_EFFORT_ALL" . "less average more")
      				   ;; ("ESTIMATED_EFFORT_ALL" . "1h 4h 1d 2d 3d 5d 8d 13d 21d 34d 55d 89d 144d 233d")
      				   ("ESTIMATED_$_COST_ALL" . "trivial small medium large")
      				   ("ACTUAL_EFFORT")
      				   ;; ("ACTUAL_$_COST")
				   )))))
