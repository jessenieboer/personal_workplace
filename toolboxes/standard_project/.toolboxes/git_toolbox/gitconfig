# Per-project git settings from the git toolbox.
# Rendered to .toolboxes/git_toolbox/gitconfig (refreshed on every shell entry,
# so do not edit it) and pulled into .git/config with include.path. Project
# overrides go in .toolboxes/git_toolbox/project.gitconfig, which is included
# after this file.
# No identity, signing or credentials here on purpose.
[pull]
	# Rebase local work on pull; refuse non-fast-forward merges.
	rebase = true
	ff = only
[merge]
	ff = only
[rebase]
	autoStash = true
[rerere]
	enabled = true
[core]
	autocrlf = false
	safecrlf = true
[diff]
	algorithm = histogram
[init]
	defaultBranch = main
[tag]
	# SemVer ordering in `git tag` (v1.10.0 after v1.9.0).
	sort = version:refname
[versionsort]
	# Pre-releases sort before their release: alpha < beta < rc < final.
	suffix = -alpha
	suffix = -beta
	suffix = -rc
[push]
	# Push annotated release tags reachable from pushed commits.
	followTags = true
[fetch]
	prune = true
	pruneTags = false
