{ pkgs, lib, config, inputs, ... }:
let
  envrc = ./programs/.envrc;
  gitignore = ./settings/.gitignore;
  root = config.devenv.root;
  envrcDest = "${root}/.envrc";
  gitignoreDest = "${root}/.toolboxes/emacs_toolbox/.gitignore";
  dirLocalsDest = "${root}/.dir-locals.el";
in
{
  config = {
    # Runs after other toolboxes' before-enterShell copy tasks so *dir_locals
    # fragments exist before this merge.
    enterShell = lib.mkAfter ''
      dest="${dirLocalsDest}"
      tmp=$(mktemp)
      {
        cat << 'EOF'
      ;; Generated by emacs toolbox enterShell
      ;; Do not edit this file directly — it will be overwritten on shell entry.
      EOF
        if [ -d "${root}/.toolboxes" ]; then
          files=$(find "${root}/.toolboxes" -type f -name '*dir_locals' | sort)
          if [ -n "$files" ]; then
            printf '%s\n' "$files" | xargs cat
          fi
        fi
      } > "$tmp"
      if [ ! -f "$dest" ] || ! cmp -s "$tmp" "$dest"; then
        mv "$tmp" "$dest"
      else
        rm -f "$tmp"
      fi
      if [ -t 1 ]; then
        echo "emacs toolbox available"
      fi
    '';

    tasks = {
      "emacs_toolbox:copy_envrc" = {
        description = "Seed .envrc once from the toolbox template";
        before = [ "devenv:enterShell" ];
        status = ''
          test -f "${envrcDest}"
        '';
        exec = ''
          install -D -m 0444 ${envrc} "${envrcDest}"
        '';
      };

      "emacs_toolbox:copy_gitignore" = {
        description = "Refresh the emacs_toolbox gitignore fragment from the toolbox";
        before = [ "devenv:enterShell" ];
        status = ''
          [ -f "${gitignoreDest}" ] && cmp -s ${gitignore} "${gitignoreDest}"
        '';
        exec = ''
          install -D -m 0644 ${gitignore} "${gitignoreDest}"
        '';
      };
    };
  };
}
