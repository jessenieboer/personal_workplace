{ pkgs, lib, config, inputs, ... }:
let
  tt = import ../_lib/toolbox_tasks.nix { inherit config pkgs; };
  root = config.devenv.root;
  dirLocalsDest = "${root}/.dir-locals.el";
in
{
  config = {
    # Runs after other toolboxes' before-enterShell copy tasks so *dir_locals
    # fragments exist before this merge.
    enterShell = lib.mkAfter ''
      dest="${dirLocalsDest}"
      tmp=$(mktemp)
      {
        cat << 'EOF'
      ;; Generated by emacs toolbox enterShell
      ;; Do not edit this file directly — it will be overwritten on shell entry.
      EOF
        if [ -d "${root}/.toolboxes" ]; then
          files=$(find "${root}/.toolboxes" -type f -name '*dir_locals' | sort)
          if [ -n "$files" ]; then
            # Emacs reads only the first form of .dir-locals.el, so splice
            # every fragment's ((MODE . VARS) ...) into one list. Repeated
            # MODE keys are fine: dir-locals applies every matching entry.
            echo "("
            for f in $files; do
              sed -z 's/^[[:space:]]*(//; s/)[[:space:]]*$//' "$f"
              echo
            done
            echo ")"
          fi
        fi
      } > "$tmp"
      if [ ! -f "$dest" ] || ! cmp -s "$tmp" "$dest"; then
        mv "$tmp" "$dest"
      else
        rm -f "$tmp"
      fi
      ${tt.announce "emacs"}
    '';

    tasks = tt.seed {
        name = "emacs"; task = "copy_envrc";
        src = ./programs/.envrc; dest = ".envrc";
      }
      // tt.gitignore "emacs" ./settings/.gitignore
      // tt.practices { name = "emacs"; local = ./practices; };
  };
}
